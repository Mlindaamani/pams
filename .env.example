# Local development defaults (copy to .env). Never commit .env.
POSTGRES_DB=pams
POSTGRES_USER=pams
POSTGRES_PASSWORD=pams
POSTGRES_PORT=5432

# Keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/pams

# Production / non-dev datasource (application-prod profile only)
PAMS_DB_URL=jdbc:postgresql://localhost:5432/pams
PAMS_DB_USERNAME=pams
PAMS_DB_PASSWORD=change-me
PAMS_DB_POOL_SIZE=20

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pams-attachments

# Mailpit (dev SMTP + web UI)
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM=no-reply@pams.local

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend container (runtime /config.js)
WEB_PORT=3000
PAMS_PUBLIC_API_URL=http://localhost:8080
PAMS_PUBLIC_OIDC_AUTHORITY=http://localhost:8081/realms/pams
PAMS_OIDC_CLIENT_ID=pams-api
PAMS_APP_URL=http://localhost:3000
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0
PAMS_IMAGE_TAG=latest
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/admin/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/admin/billing?checkout=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/admin/billing
STRIPE_TEST_CLOCK_PRICE_ID=
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8081
KEYCLOAK_ADMIN_REALM=pams
KEYCLOAK_ADMIN_CLIENT_ID=pams-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_AUTH_REALM=master
KEYCLOAK_ADMIN_FALLBACK_USER=
KEYCLOAK_ADMIN_FALLBACK_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
