# Production values. Copy to a secret manager-backed env file; never commit real secrets.
POSTGRES_DB=pams
POSTGRES_USER=pams
POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_DB_NAME=keycloak

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_ISSUER_URI=https://auth.example.com/realms/pams
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
KEYCLOAK_ADMIN_REALM=pams
KEYCLOAK_ADMIN_AUTH_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=pams-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
# Create a production-only realm export; never import the demo seed with known users.
KEYCLOAK_REALM_IMPORT=/secure/path/pams-production-realm.json

MINIO_IMAGE=bitnamilegacy/minio:2025.4.22-debian-12-r2
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=pams-attachments

REDIS_HOST=redis
REDIS_PORT=6379
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_FROM=no-reply@example.com

PAMS_PUBLIC_API_URL=https://api.example.com
PAMS_PUBLIC_OIDC_AUTHORITY=https://auth.example.com/realms/pams
PAMS_OIDC_CLIENT_ID=pams-frontend
PAMS_APP_URL=https://app.example.com
PAMS_IMAGE_TAG=changeme-git-sha

OTLP_TRACING_ENDPOINT=https://otel.example.com/v1/traces
TRACING_SAMPLING_PROBABILITY=0.1

STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
STRIPE_SUCCESS_URL=https://app.example.com/admin/billing?checkout=success
STRIPE_CANCEL_URL=https://app.example.com/admin/billing?checkout=cancel
STRIPE_PORTAL_RETURN_URL=https://app.example.com/admin/billing

# Backup tooling
BACKUP_ROOT=/var/backups/pams
BACKUP_RETENTION_DAYS=30
MINIO_DATA_PATH=/bitnami/minio/data
