meta {
  name: Reject current step
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/approvals/{{approvalStepId}}/reject
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Idempotency-Key: {{$uuid}}
}

body:json {
  {
    "comment": "Not approved this quarter"
  }
}
