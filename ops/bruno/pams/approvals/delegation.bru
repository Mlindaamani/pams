meta {
  name: Create delegation
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/delegations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "delegateUserId": "{{userId}}",
    "startsAt": "2026-01-01T00:00:00Z",
    "endsAt": "2026-12-31T23:59:59Z"
  }
}
