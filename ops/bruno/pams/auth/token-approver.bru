meta {
  name: Token (approver)
  type: http
  seq: 4
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: pams-api
  username: approver
  password: approver
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.access_token);
}
