meta {
  name: Token (procurement officer)
  type: http
  seq: 2
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: pams-api
  username: officer
  password: officer
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.access_token);
}
