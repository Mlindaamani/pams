meta {
  name: Token (admin)
  type: http
  seq: 1
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: pams-api
  username: admin
  password: admin
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.access_token);
}
