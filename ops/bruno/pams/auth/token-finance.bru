meta {
  name: Token (finance)
  type: http
  seq: 1
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: pams-api
  username: finance
  password: finance
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.access_token);
}
