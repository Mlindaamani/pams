meta {
  name: Token (requester)
  type: http
  seq: 3
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: pams-api
  username: requester
  password: requester
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.access_token);
}
