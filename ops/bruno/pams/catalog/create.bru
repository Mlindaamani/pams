meta {
  name: Create catalog item
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/catalog-items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "sku": "LAPTOP-001",
    "name": "Business Laptop",
    "unit": "EA",
    "defaultPrice": {
      "amount": "1500.0000",
      "currency": "TZS"
    },
    "category": "IT"
  }
}

script:post-response {
  bru.setEnvVar("catalogItemId", res.body.id);
}
