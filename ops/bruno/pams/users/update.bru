meta {
  name: Update user profile
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/users/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "displayName": "Demo Requester Updated",
    "departmentId": "{{departmentId}}",
    "approvalLimit": {
      "amount": "7500.0000",
      "currency": "TZS"
    },
    "active": true
  }
}
