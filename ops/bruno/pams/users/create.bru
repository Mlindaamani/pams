meta {
  name: Create user profile
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "keycloakSubject": "requester",
    "email": "requester@example.com",
    "displayName": "Demo Requester",
    "departmentId": "{{departmentId}}",
    "approvalLimit": {
      "amount": "5000.0000",
      "currency": "TZS"
    }
  }
}

script:post-response {
  bru.setEnvVar("userId", res.body.id);
}
