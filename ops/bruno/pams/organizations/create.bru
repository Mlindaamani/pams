meta {
  name: Create organization
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/organizations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Demo Organization",
    "slug": "demo-org"
  }
}

script:post-response {
  bru.setEnvVar("orgId", res.body.id);
}
